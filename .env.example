# TraderLab Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── PostgreSQL ───────────────────────────────────────────────
# Use a dedicated, least-privilege database user for the application.
TRADERLAB_DB_HOST=localhost
TRADERLAB_DB_PORT=5432
TRADERLAB_DB_NAME=traderlab
TRADERLAB_DB_USER=traderlab_app
TRADERLAB_DB_PASSWORD=CHANGE_ME
TRADERLAB_DB_SCHEMA=public

# ─── Application ──────────────────────────────────────────────
TRADERLAB_ENV=development
TRADERLAB_LOG_LEVEL=INFO

# ─── External Historical Datasets ─────────────────────────────
# Path to sibling Market-Data-Lab repository (read-only historical CSV files)
EXTERNAL_XAUUSD_DATA_DIR=../Market-Data-Lab
